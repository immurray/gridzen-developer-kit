        220,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "http://127.0.0.1:8787/sessions",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{}",
        "options": {
          "timeout": 3000
        }
      }
    },
    {
      "id": "wait-bounded-deadline",
      "name": "Wait bounded deadline",
      "type": "n8n-nodes-base.wait",
