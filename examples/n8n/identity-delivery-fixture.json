    {
      "id": "fixture-callback",
      "name": "Fixture callback",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        260
      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "gridzen-fixture-callback",
        "responseMode": "responseNode",
        "options": {}
      },
      "webhookId": "21a06925-bedd-5e72-8d4c-91125f76f131"
    },
    {
      "id": "apply-bound-fixture-event",
      "name": "Apply bound fixture event",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        220,
        260
      ],
      "parameters": {
        "method": "POST",
        "url": "http://127.0.0.1:8787/events",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.body) }}",
        "options": {
          "timeout": 3000
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "id": "respond-with-fixture-outcome",
      "name": "Respond with fixture outcome",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.4,
      "position": [
        440,
        260
      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ $json.error ? {mode:'synthetic_fixture',status:'unknown',permission_granted:false,error:'fixture_service_or_binding_error'} : $json }}",
        "options": {
          "responseCode": "={{ $json.error ? 422 : 200 }}"
        }
      }
    },
    {
      "id": "read-fixture-status",
      "name": "Read fixture status",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        520
      ],
      "parameters": {
        "httpMethod": "GET",
        "path": "gridzen-fixture-status",
        "responseMode": "responseNode",
        "options": {}
      },
      "webhookId": "2b5e9ae6-c2a0-5b14-b66a-3db3b593c716"
    },
    {
      "id": "get-persisted-state",
      "name": "Get persisted state",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        220,
        520
      ],
      "parameters": {
        "url": "http://127.0.0.1:8787/sessions/fixture-session",
        "options": {
          "timeout": 3000
        }
      }
    },
    {
      "id": "return-persisted-state",
      "name": "Return persisted state",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.4,
      "position": [
        440,
        520
      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ $json }}",
        "options": {}
      }
    },
    {
      "id": "synthetic-only",
      "name": "Synthetic only",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        0,
        -280
      ],
      "parameters": {
        "content": "## Synthetic fixture only\nNo real identity, OTP, signature verifier or customer permission. Start the local fixture server first; never expose its loopback API publicly. callback inputs: event, session, tenant, subject, status, policy. Unknown errors never grant.",
        "height": 220,
        "width": 800
      }
    }
  ],
